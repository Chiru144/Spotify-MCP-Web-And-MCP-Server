# Spotify Developer API Credentials (PKCE Flow - No Secret Required!)
# Get your Client ID from https://developer.spotify.com/dashboard
SPOTIPY_CLIENT_ID=
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# TMDB (The Movie Database) API Credentials
# Get from https://www.themoviedb.org/settings/api
# Provide ANY ONE (either TMDB_API_KEY or TMDB_READ_ACCESS_TOKEN):
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=
TMDB_BASE_URL=https://api.themoviedb.org/3
